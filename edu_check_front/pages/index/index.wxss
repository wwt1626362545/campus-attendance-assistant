/* =============================================
  晨光校园 · 首页样式 v2.0
  ============================================= */

/* ---------- 英雄区域 - 渐变头部 ---------- */
.hero-section {
  position: relative;
  border-radius: 28rpx;
  overflow: hidden;
  margin-bottom: 28rpx;
  min-height: 220rpx;
}

.hero-bg {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: linear-gradient(135deg, #6C5CE7 0%, #A29BFE 50%, #B8B0FF 100%);
}

.hero-bg-circle {
  position: absolute;
  border-radius: 50%;
  opacity: 0.2;
}

.hero-circle-1 {
  width: 300rpx;
  height: 300rpx;
  background: #fff;
  top: -80rpx;
  right: -60rpx;
}

.hero-circle-2 {
  width: 180rpx;
  height: 120rpx;
  background: #FF7675;
  bottom: -40rpx;
  left: -30rpx;
}

.hero-circle-3 {
  width: 120rpx;
  height: 120rpx;
  background: #FDCB6E;
  top: 40rpx;
  right: 40rpx;
}

.hero-content {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 36rpx 32rpx;
  z-index: 1;
}

.hero-user {
  display: flex;
  align-items: center;
  flex: 1;
}

.hero-avatar-wrap {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  border: 4rpx solid rgba(255, 255, 255, 0.5);
  overflow: hidden;
  flex-shrink: 0;
  background: rgba(255, 255, 255, 0.2);
  backdrop-filter: blur(4rpx);
}

.hero-avatar {
  width: 100%;
  height: 100%;
}

.hero-info {
  margin-left: 24rpx;
  display: flex;
  flex-direction: column;
}

.hero-name {
  font-size: 38rpx;
  font-weight: 700;
  color: #fff;
  margin-bottom: 6rpx;
  text-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.1);
}

.hero-desc {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.85);
  opacity: 0.9;
}

.hero-badge {
  padding: 10rpx 24rpx;
  border-radius: 28rpx;
  backdrop-filter: blur(10px);
  flex-shrink: 0;
}

.badge-student {
  background: rgba(255, 118, 117, 0.25);
  border: 1rpx solid rgba(255, 118, 117, 0.3);
}

.badge-teacher {
  background: rgba(253, 203, 110, 0.25);
  border: 1rpx solid rgba(253, 203, 110, 0.3);
}

.hero-badge-text {
  font-size: 20rpx;
  color: #fff;
  font-weight: 500;
}

/* 装饰 */
.hero-decoration {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 32rpx 16rpx;
  gap: 12rpx;
  z-index: 1;
}

.deco-line {
  flex: 1;
  height: 1rpx;
  background: rgba(255, 255, 255, 0.2);
}

.deco-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.4);
}

/* ---------- 离线提示 ---------- */
.offline-banner {
  display: flex;
  align-items: center;
  gap: 12rpx;
  background: #FFF5E6;
  padding: 16rpx 24rpx;
  border-radius: 16rpx;
  margin-bottom: 24rpx;
  font-size: 22rpx;
  color: #E89B3C;
}

.offline-icon {
  font-size: 28rpx;
}

/* ---------- 轮播图 ---------- */
.banner-swiper {
  width: 100%;
  height: 280rpx;
  border-radius: 24rpx;
  overflow: hidden;
  margin-bottom: 28rpx;
  box-shadow: 0 4rpx 16rpx rgba(108, 92, 231, 0.08);
}

.banner-img {
  width: 100%;
  height: 100%;
  border-radius: 24rpx;
}

/* ---------- 统计网格 ---------- */
.stats-grid {
  display: flex;
  gap: 16rpx;
  margin-bottom: 36rpx;
}

.stat-card {
  flex: 1;
  background: #fff;
  border-radius: 20rpx;
  padding: 28rpx 16rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  box-shadow: 0 4rpx 16rpx rgba(108, 92, 231, 0.08);
  transition: all 0.25s ease;
}

.stat-active {
  transform: scale(0.94);
  box-shadow: 0 2rpx 8rpx rgba(108, 92, 231, 0.12);
}

.stat-icon {
  width: 72rpx;
  height: 72rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 14rpx;
}

.stat-icon-dorm {
  background: linear-gradient(135deg, #F0EEFF, #E8E3FF);
}

.stat-icon-class {
  background: linear-gradient(135deg, #FFF5E6, #FFECD2);
}

.stat-icon-intern {
  background: linear-gradient(135deg, #E8FAF3, #D4F5E8);
}

.stat-emoji {
  font-size: 34rpx;
}

.stat-num {
  font-size: 20rpx;
  font-weight: 800;
  color: #2D223C;
  margin-bottom: 4rpx;
  font-variant-numeric: tabular-nums;
}

.stat-label {
  font-size: 20rpx;
  color: #8E82A5;
  font-weight: 500;
}

/* ---------- 区块标题 ---------- */
.section-header {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  margin-bottom: 20rpx;
}

.section-title-line {
  width: 36rpx;
  height: 3rpx;
  border-radius: 3rpx;
  background: linear-gradient(90deg, transparent, #6C5CE7);
}

.section-title-line:last-child {
  background: linear-gradient(90deg, #6C5CE7, transparent);
}

.section-title-text {
  font-size: 20rpx;
  font-weight: 700;
  color: #2D223C;
  letter-spacing: 2rpx;
}

/* ---------- 功能网格 ---------- */
.feature-grid {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.feature-card {
  border-radius: 20rpx;
  overflow: hidden;
  position: relative;
  transition: all 0.25s ease;
}

.feature-active {
  transform: scale(0.97);
}

.feature-bg {
  padding: 24rpx 28rpx;
  display: flex;
  align-items: center;
  gap: 24rpx;
  position: relative;
  z-index: 1;
}

.feature-dorm {
  background: linear-gradient(135deg, #F0EEFF 0%, #E8E3FF 100%);
}

.feature-class {
  background: linear-gradient(135deg, #FFF5E6 0%, #FFECD2 100%);
}

.feature-intern {
  background: linear-gradient(135deg, #E8FAF3 0%, #D4F5E8 100%);
}

.feature-teacher-students {
  background: linear-gradient(135deg, #F0EEFF 0%, #E8E3FF 100%);
}

.feature-teacher-leave {
  background: linear-gradient(135deg, #FFF5E6 0%, #FFECD2 100%);
}

.feature-teacher-code {
  background: linear-gradient(135deg, #F3E8FF 0%, #E8D5FF 100%);
}

.feature-teacher-data {
  background: linear-gradient(135deg, #E8FAF3 0%, #D4F5E8 100%);
}

.feature-icon-box {
  width: 40rpx;
  height: 40rpx;
  border-radius: 18rpx;
  background: rgba(255, 255, 255, 0.85);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  box-shadow: 0 3rpx 10rpx rgba(108, 92, 231, 0.08);
}

.feature-emoji {
  font-size: 18rpx;
}

.feature-name {
  font-size: 20rpx;
  font-weight: 700;
  color: #2D223C;
  margin-bottom: 2rpx;
}

.feature-desc {
  font-size: 20rpx;
  color: #8E82A5;
}

.feature-shimmer {
  position: absolute;
  top: 0;
  right: 0;
  width: 160rpx;
  height: 100%;
  background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.3));
  transform: skewX(-20deg) translateX(60rpx);
  transition: transform 0.6s ease;
}

.feature-card:active .feature-shimmer {
  transform: skewX(-20deg) translateX(200rpx);
}

/* ---------- 每日思语 ---------- */
.daily-section {
  background: linear-gradient(135deg, #2D223C 0%, #3D2E5C 100%);
  border-radius: 24rpx;
  padding: 36rpx 32rpx;
  position: relative;
  overflow: hidden;
  margin-bottom: 16rpx;
}

.daily-bg-deco {
  position: absolute;
  top: -60rpx;
  right: -60rpx;
  width: 200rpx;
  height: 120rpx;
  border-radius: 50%;
  background: rgba(162, 155, 254, 0.08);
}

.daily-header {
  margin-bottom: 20rpx;
}

.daily-label {
  font-size: 28rpx;
  font-weight: 600;
  color: rgba(255, 255, 255, 0.9);
}

.daily-content {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.8);
  line-height: 1.9;
  letter-spacing: 1rpx;
  text-indent: 2em;
}

.daily-footer {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 24rpx;
}

.daily-line {
  width: 48rpx;
  height: 3rpx;
  background: rgba(253, 203, 110, 0.4);
  border-radius: 2rpx;
}

.daily-source {
  font-size: 20rpx;
  color: rgba(253, 203, 110, 0.6);
  font-style: italic;
}

/* ====== 旋转轮盘 ====== */
.wheel-scroll {
  width: 100%;
  margin-bottom: 16rpx;
}
.wheel-track {
  display: flex;
  align-items: center;
  padding: 12rpx 16rpx;
  gap: 0;
}

/* 轮盘卡片 */
.wheel-card {
  width: 300rpx;
  flex-shrink: 0;
  margin: 0 12rpx;
  transition: transform 0.35s cubic-bezier(0.4, 0, 0.2, 1), opacity 0.35s ease;
}
.wheel-card:active {
  transform: scale(0.96);
}

.wheel-bg {
  position: relative;
  border-radius: 24rpx;
  padding: 32rpx 20rpx 24rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  overflow: hidden;
  min-height: 230rpx;
  justify-content: center;
}
.wheel-dorm-bg {
  background: linear-gradient(160deg, #F0EEFF 0%, #E0DAFF 40%, #C8BFFF 100%);
}
.wheel-class-bg {
  background: linear-gradient(160deg, #FFF5E6 0%, #FFE8CC 40%, #FFD699 100%);
}
.wheel-intern-bg {
  background: linear-gradient(160deg, #E8FAF3 0%, #CCF2DF 40%, #A8E6CE 100%);
}

/* 装饰圆环 */
.wheel-ring {
  position: absolute;
  top: -30rpx;
  right: -30rpx;
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  border: 3rpx solid rgba(255, 255, 255, 0.5);
  opacity: 0.6;
}

/* 图标盒子 */
.wheel-icon-box {
  width: 76rpx;
  height: 76rpx;
  border-radius: 20rpx;
  background: rgba(255, 255, 255, 0.9);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 12rpx;
  box-shadow: 0 6rpx 18rpx rgba(108, 92, 231, 0.12);
  position: relative;
  z-index: 1;
}
.wheel-emoji {
  font-size: 38rpx;
}

.wheel-name {
  font-size: 28rpx;
  font-weight: 700;
  color: #2D223C;
  margin-bottom: 4rpx;
  position: relative;
  z-index: 1;
}
.wheel-desc {
  font-size: 20rpx;
  color: #8E82A5;
  margin-bottom: 12rpx;
  position: relative;
  z-index: 1;
}

/* 轮盘点指示器 */
.wheel-dots {
  display: flex;
  gap: 8rpx;
  position: relative;
  z-index: 1;
}
.wheel-dot {
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background: rgba(0, 0, 0, 0.12);
  transition: all 0.3s ease;
}
.wheel-dot.active {
  width: 22rpx;
  border-radius: 5rpx;
  background: #6C5CE7;
}

/* 中心指示线 */
.wheel-indicator {
  display: flex;
  justify-content: center;
  margin-top: 0;
  margin-bottom: 16rpx;
}
.wheel-indicator-line {
  width: 40rpx;
  height: 3rpx;
  border-radius: 3rpx;
  background: linear-gradient(90deg, transparent, #6C5CE7, transparent);
}
/* 统计轮盘数字 */
.wheel-stat-num {
  font-size: 42rpx;
  font-weight: 800;
  color: #2D223C;
  margin-bottom: 2rpx;
  font-variant-numeric: tabular-nums;
  position: relative;
  z-index: 1;
}