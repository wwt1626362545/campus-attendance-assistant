/* =============================================
  晨光校园 · 智能问答页面样式 v2.0
  ============================================= */

.page-header { margin-bottom: 24rpx; }

/* 分类标签 */
.category-scroll { white-space: nowrap; margin-bottom: 24rpx; }
.category-list { display: flex; gap: 16rpx; padding: 4rpx 0; }
.category-tag {
  display: inline-flex; padding: 14rpx 28rpx;
  background: #fff; border-radius: 32rpx;
  font-size: 24rpx; color: #8E82A5;
  box-shadow: 0 2rpx 8rpx rgba(108,92,231,0.06);
  transition: all 0.25s ease;
}
.category-tag.active {
  background: linear-gradient(135deg, #6C5CE7, #A29BFE);
  color: #fff; font-weight: 600;
  box-shadow: 0 4rpx 16rpx rgba(108,92,231,0.25);
}

/* 对话区域 */
.chat-scroll {
  height: calc(100vh - 300rpx);
  margin-bottom: 20rpx;
}
.chat-area { padding-bottom: 20rpx; }
.msg-item { display: flex; gap: 16rpx; margin-bottom: 24rpx; }
.msg-right { flex-direction: row-reverse; }

.msg-avatar {
  width: 56rpx; height: 56rpx; border-radius: 50%;
  display: flex; align-items: center; justify-content: center;
  font-size: 22rpx; font-weight: 600; flex-shrink: 0;
}
.bot-avatar { background: linear-gradient(135deg, #F0EEFF, #E8E3FF); color: #6C5CE7; }
.user-avatar { background: linear-gradient(135deg, #FFF5E6, #FFECD2); color: #E89B3C; }

.msg-content { max-width: 560rpx; }
.msg-bubble {
  padding: 20rpx 24rpx; border-radius: 20rpx;
  font-size: 26rpx; line-height: 1.6; word-break: break-word;
}
.bubble-bot {
  background: #fff; color: #2D223C;
  box-shadow: 0 2rpx 8rpx rgba(108,92,231,0.06);
}
.bubble-user {
  background: linear-gradient(135deg, #6C5CE7, #A29BFE);
  color: #fff;
}

/* 快捷问题 */
.quick-area {
  background: #fff; border-radius: 20rpx;
  padding: 28rpx; margin-bottom: 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(108,92,231,0.08);
}
.quick-title {
  font-size: 26rpx; font-weight: 600; color: #2D223C;
  display: block; margin-bottom: 16rpx;
}
.quick-tags { display: flex; flex-wrap: wrap; gap: 12rpx; }
.quick-q {
  padding: 14rpx 24rpx; background: #F5F3FA;
  border-radius: 28rpx; font-size: 24rpx; color: #6C5CE7;
  transition: all 0.2s;
}
.quick-q:active { background: #EDE7F6; transform: scale(0.96); }

/* 输入栏 */
.input-bar {
  display: flex; align-items: center; gap: 16rpx;
  padding: 20rpx 32rpx; background: #fff;
  border-top: 2rpx solid #F3EFF9;
  box-shadow: 0 -4rpx 16rpx rgba(108,92,231,0.04);
  position: fixed; bottom: 0; left: 0; right: 0; z-index: 100;
}
.msg-input {
  flex: 1; height: 72rpx; background: #F5F3FA;
  border-radius: 36rpx; padding: 0 28rpx;
  font-size: 28rpx; color: #2D223C;
}
.msg-input::placeholder { color: #B8B0CC; font-size: 26rpx; }
.send-btn {
  height: 72rpx; padding: 0 32rpx;
  border-radius: 36rpx; background: #EDE7F6;
  display: flex; align-items: center; justify-content: center;
  font-size: 26rpx; color: #B8B0CC; font-weight: 600;
  transition: all 0.25s; flex-shrink: 0;
}
.send-btn.active {
  background: linear-gradient(135deg, #6C5CE7, #A29BFE);
  color: #fff;
  box-shadow: 0 4rpx 12rpx rgba(108,92,231,0.3);
}
