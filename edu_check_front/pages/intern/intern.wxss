/* =============================================
  晨光校园 · 实习打卡页面样式 v2.0
  ============================================= */

.page-header { margin-bottom: 24rpx; }

.card.time-card {
  display: flex;
  justify-content: space-between;
  align-items: center;
  background: linear-gradient(135deg, #2D223C, #3D2E5C) !important;
  padding: 32rpx;
}

.time-left { display: flex; flex-direction: column; }
.time-label { font-size: 22rpx; color: rgba(255,255,255,0.5); margin-bottom: 6rpx; }
.time-value { font-size: 56rpx; font-weight: 800; color: #fff; font-variant-numeric: tabular-nums; letter-spacing: 2rpx; }
.time-right { display: flex; flex-direction: column; align-items: flex-end; }
.time-date { font-size: 28rpx; color: rgba(255,255,255,0.75); }
.time-weekday { font-size: 24rpx; color: rgba(255,255,255,0.45); margin-top: 4rpx; }

/* 卡片头部 */
.card-header-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.card-section-title { font-size: 30rpx; font-weight: 700; color: #2D223C; }

/* 状态徽章 */
.status-badge {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 22rpx;
  padding: 6rpx 18rpx;
  border-radius: 20rpx;
}
.badge-success { background: #E8FAF3; color: #3BAD85; }
.badge-idle { background: #F3F0F9; color: #8E82A5; }
.badge-dot { width: 10rpx; height: 10rpx; border-radius: 50%; }
.dot-success { background: #3BAD85; }
.dot-idle { background: #B8B0CC; }

/* 定位 */
.location-card { padding: 28rpx; }
.map-bg {
  width: 100%; height: 160rpx;
  background: #F5F3FA; border-radius: 16rpx;
  display: flex; align-items: center; justify-content: center;
  transition: all 0.3s;
}
.map-bg:active { transform: scale(0.98); opacity: 0.8; }
.map-bg.map-located { background: #F0EEFF; }
.map-icon { font-size: 56rpx; }
.detail-hint { font-size: 24rpx; color: #B8B0CC; text-align: center; display: block; }
.detail-addr {
  display: inline-block; font-size: 24rpx; color: #2D223C;
  padding: 8rpx 20rpx; background: #F5F3FA; border-radius: 12rpx; word-break: break-all;
}

/* 日志上传 */
.log-card { padding: 28rpx; }
.log-textarea {
  width: 100%; height: 200rpx;
  background: #F5F3FA; border-radius: 14rpx;
  padding: 22rpx 24rpx; font-size: 28rpx; color: #2D223C;
  line-height: 1.6; transition: all 0.2s;
}
.log-textarea:focus {
  background: #fff; box-shadow: 0 2rpx 8rpx rgba(108, 92, 231, 0.06);
  border: 2rpx solid #6C5CE7; padding: 20rpx 22rpx;
}
.log-textarea::placeholder { color: #B8B0CC; font-size: 26rpx; }

.btn-primary { margin: 8rpx 0 32rpx; }

/* 历史记录 */
.history-card { padding: 28rpx; }
.history-more { font-size: 24rpx; color: #6C5CE7; font-weight: 500; }
.history-item {
  display: flex; align-items: center; justify-content: space-between;
  padding: 18rpx 0; border-bottom: 2rpx solid #F3EFF9;
}
.history-item:last-child { border-bottom: none; }
.history-date { font-size: 26rpx; color: #2D223C; font-weight: 500; }
.history-time { font-size: 24rpx; color: #8E82A5; }

/* ===== 人脸验证（从查寝打卡复用） ===== */

/* ===== 人脸验证（从查寝打卡复用） ===== */
.face-card {
  padding: 28rpx;
}
.face-area {
  width: 100%;
  height: 200rpx;
  background: #F5F3FA;
  border: 2rpx dashed #D5D0E8;
  border-radius: 16rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  transition: all 0.3s;
}
.face-area:active {
  opacity: 0.7;
  background: #EDE7F6;
}
.face-area.face-verified {
  border-color: #55C9A6;
  background: #E8FAF3;
}
.face-icon {
  font-size: 56rpx;
  margin-bottom: 8rpx;
}
.face-tip {
  font-size: 24rpx;
  color: #8E82A5;
}
.face-status-area {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 36rpx 0;
}
.face-loading-ring {
  width: 48rpx;
  height: 48rpx;
  border: 4rpx solid #EDE7F6;
  border-top-color: #6C5CE7;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
  margin-bottom: 12rpx;
}
.face-verify-msg {
  font-size: 26rpx;
  color: #6C5CE7;
  font-weight: 500;
}
.face-error {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 20rpx;
  background: #FFEEF0;
  border-radius: 12rpx;
  margin-top: 12rpx;
}
.face-error-text {
  font-size: 24rpx;
  color: #FF5A6A;
  flex: 1;
}
.face-retake {
  font-size: 24rpx;
  color: #6C5CE7;
  font-weight: 500;
  flex-shrink: 0;
}
.face-photo-wrap {
  width: 100%;
  height: 300rpx;
  border-radius: 16rpx;
  overflow: hidden;
  margin-top: 12rpx;
}
.face-photo {
  width: 100%;
  height: 100%;
}

