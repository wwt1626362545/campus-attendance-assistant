/* =============================================
  晨光校园 · 课程表页面样式 v2.0
  ============================================= */

.page-header { margin-bottom: 24rpx; }

/* 周选择器 */
.week-selector {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 24rpx;
  margin-bottom: 24rpx;
}

.week-arrow {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  color: #6C5CE7;
  box-shadow: 0 2rpx 8rpx rgba(108, 92, 231, 0.08);
  transition: all 0.2s;
}

.week-arrow:active { transform: scale(0.9); background: #F0EEFF; }

.week-info { text-align: center; }
.week-label { font-size: 28rpx; font-weight: 600; color: #2D223C; display: block; margin-bottom: 4rpx; }
.week-range { font-size: 22rpx; color: #8E82A5; }

/* 星期条 */
.weekday-bar {
  display: flex;
  background: #fff;
  border-radius: 16rpx;
  padding: 16rpx 8rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(108, 92, 231, 0.06);
}

.weekday-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}

.weekday-name {
  font-size: 20rpx;
  color: #8E82A5;
}

.weekday-date {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  color: #2D223C;
  transition: all 0.2s;
}

.weekday-date.today {
  color: #6C5CE7;
  font-weight: 700;
}

.weekday-date.selected {
  background: linear-gradient(135deg, #6C5CE7, #A29BFE);
  color: #fff;
  font-weight: 600;
}

/* 课程列表 */
.schedule-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.schedule-item {
  display: flex;
  gap: 20rpx;
}

.schedule-time {
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 100rpx;
  flex-shrink: 0;
  padding-top: 8rpx;
}

.schedule-start, .schedule-end {
  font-size: 22rpx;
  color: #8E82A5;
  font-variant-numeric: tabular-nums;
}

.schedule-time-line {
  display: flex;
  flex-direction: column;
  align-items: center;
  flex: 1;
  margin: 8rpx 0;
}

.time-dot {
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background: #6C5CE7;
}

.time-line {
  flex: 1;
  width: 2rpx;
  background: #EDE7F6;
}

.schedule-card {
  flex: 1;
  border-radius: 20rpx;
  padding: 24rpx;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.schedule-card.default {
  background: linear-gradient(135deg, #F0EEFF, #E8E3FF);
  border-left: 4rpx solid #6C5CE7;
}

.schedule-card.green {
  background: linear-gradient(135deg, #E8FAF3, #D4F5E8);
  border-left: 4rpx solid #55C9A6;
}

.schedule-card.orange {
  background: linear-gradient(135deg, #FFF5E6, #FFECD2);
  border-left: 4rpx solid #E89B3C;
}

.schedule-card.pink {
  background: linear-gradient(135deg, #FFEEF0, #FFE3E5);
  border-left: 4rpx solid #FF5A6A;
}

.schedule-course-name {
  font-size: 30rpx;
  font-weight: 700;
  color: #2D223C;
}

.schedule-teacher {
  font-size: 24rpx;
  color: #8E82A5;
}

.schedule-tags {
  display: flex;
  gap: 10rpx;
  margin-top: 4rpx;
}
