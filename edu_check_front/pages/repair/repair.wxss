.form-card { background:#fff; border-radius:24rpx; padding:32rpx; margin-bottom:24rpx; box-shadow:0 4rpx 16rpx rgba(108,92,231,0.08); }
.form-group { margin-bottom:24rpx; }
.form-label { font-size:26rpx; color:#2D223C; display:block; margin-bottom:12rpx; font-weight:600; }
.input-field { width:100%; height:80rpx; background:#F5F3FA; border-radius:14rpx; padding:0 24rpx; font-size:26rpx; color:#2D223C; box-sizing:border-box; }
.form-textarea { width:100%; background:#F5F3FA; border-radius:14rpx; padding:22rpx 24rpx; font-size:26rpx; color:#2D223C; height:200rpx; line-height:1.6; box-sizing:border-box; }
.picker-display { height:80rpx; line-height:80rpx; background:#F5F3FA; border-radius:14rpx; padding:0 24rpx; font-size:26rpx; color:#2D223C; }

.filter-bar { display:flex; gap:12rpx; margin-bottom:16rpx; }
.filter-tag { padding:10rpx 28rpx; border-radius:28rpx; font-size:24rpx; background:#fff; color:#8E82A5; box-shadow:0 2rpx 8rpx rgba(108,92,231,0.06); }
.filter-tag.active { background:#6C5CE7; color:#fff; }

.section-header { display:flex; align-items:center; justify-content:center; gap:16rpx; margin:16rpx 0 20rpx; }
.section-title-line { width:36rpx; height:3rpx; border-radius:3rpx; background:linear-gradient(90deg,transparent,#6C5CE7); }
.section-title-line:last-child { background:linear-gradient(90deg,#6C5CE7,transparent); }
.section-title-text { font-size:20rpx; font-weight:700; color:#2D223C; letter-spacing:2rpx; }

.repair-list { display:flex; flex-direction:column; gap:16rpx; padding-bottom:16rpx; }
.repair-item { background:#fff; border-radius:20rpx; padding:28rpx; box-shadow:0 4rpx 16rpx rgba(108,92,231,0.06); }
.repair-header { display:flex; justify-content:space-between; align-items:center; margin-bottom:10rpx; }
.repair-cat { font-size:20rpx; padding:4rpx 16rpx; border-radius:20rpx; background:#F0EEFF; color:#6C5CE7; font-weight:600; }
.repair-status { font-size:18rpx; padding:4rpx 14rpx; border-radius:20rpx; }
.repair-status.pending { background:#FFF5E6; color:#E89B3C; }
.repair-status.done { background:#E8FAF3; color:#55C9A6; }
.repair-student { font-size:22rpx; color:#6C5CE7; margin-bottom:6rpx; }
.repair-dorm { font-size:22rpx; color:#8E82A5; display:block; margin-bottom:4rpx; }
.repair-desc { font-size:26rpx; color:#2D223C; line-height:1.6; display:block; }
.repair-footer { display:flex; justify-content:space-between; align-items:center; margin-top:14rpx; }
.repair-time { font-size:20rpx; color:#B8B0CC; }
.repair-phone { font-size:20rpx; color:#8E82A5; }
.repair-reply { margin-top:12rpx; padding:12rpx 16rpx; background:#F8F7FF; border-radius:12rpx; border-left:4rpx solid #6C5CE7; font-size:24rpx; color:#2D223C; }

.repair-actions { display:flex; gap:12rpx; margin-top:16rpx; padding-top:14rpx; border-top:2rpx solid #F3EFF9; }
.reply-input { flex:1; height:62rpx; background:#F5F3FA; border-radius:10rpx; padding:0 16rpx; font-size:24rpx; color:#2D223C; }
.repair-btn { padding:0 24rpx; height:62rpx; line-height:62rpx; background:#6C5CE7; color:#fff; border-radius:10rpx; font-size:24rpx; font-weight:600; flex-shrink:0; }
.repair-btn:active { opacity:0.8; }

.loading-tip, .empty-tip { text-align:center; padding:48rpx 0; font-size:26rpx; color:#B8B0CC; }
