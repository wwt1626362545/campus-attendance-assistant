/* =============================================
  晨光校园 · 意见反馈页面样式 v2.0
  ============================================= */

.page-header { margin-bottom: 28rpx; }
.page-title { font-size: 36rpx; font-weight: 700; color: #2D223C; }
.page-subtitle { font-size: 24rpx; color: #8E82A5; margin-top: 8rpx; }

/* -------- 区块标题 -------- */
.section-header {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  margin-bottom: 20rpx;
  margin-top: 16rpx;
}
.section-title-line {
  width: 36rpx;
  height: 3rpx;
  border-radius: 3rpx;
  background: linear-gradient(90deg, transparent, #6C5CE7);
}
.section-title-line:last-child {
  background: linear-gradient(90deg, #6C5CE7, transparent);
}
.section-title-text {
  font-size: 20rpx;
  font-weight: 700;
  color: #2D223C;
  letter-spacing: 2rpx;
}

/* -------- 表单卡片 -------- */
.form-card {
  background: #fff;
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(108, 92, 231, 0.08);
}

.form-group { margin-bottom: 24rpx; }
.form-group:last-child { margin-bottom: 0; }

.form-label {
  font-size: 26rpx;
  color: #2D223C;
  display: block;
  margin-bottom: 12rpx;
  font-weight: 600;
}

/* 类型选择 */
.type-options {
  display: flex;
  gap: 12rpx;
}

.type-option {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
  padding: 18rpx 12rpx;
  background: #F5F3FA;
  border-radius: 16rpx;
  font-size: 22rpx;
  color: #8E82A5;
  transition: all 0.25s;
}

.type-option:active { background: #EDE7F6; }

.type-option.active {
  background: #F0EEFF;
  border: 2rpx solid #6C5CE7;
  color: #6C5CE7;
  font-weight: 600;
}

.type-option text:first-child {
  font-size: 28rpx;
}

.form-textarea {
  width: 100%;
  background: #F5F3FA;
  border-radius: 14rpx;
  padding: 22rpx 24rpx;
  font-size: 26rpx;
  color: #2D223C;
  height: 240rpx;
  line-height: 1.6;
  transition: all 0.2s;
  box-sizing: border-box;
}

.form-textarea:focus {
  background: #fff;
  box-shadow: 0 2rpx 8rpx rgba(108, 92, 231, 0.06);
  border: 2rpx solid #6C5CE7;
  padding: 20rpx 22rpx;
}

.form-textarea::placeholder { color: #B8B0CC; font-size: 24rpx; }

.form-counter {
  display: block;
  text-align: right;
  font-size: 20rpx;
  color: #B8B0CC;
  margin-top: 6rpx;
}

.input-field {
  width: 100%;
  height: 80rpx;
  background: #F5F3FA;
  border-radius: 14rpx;
  padding: 0 24rpx;
  font-size: 26rpx;
  color: #2D223C;
  transition: all 0.2s;
  box-sizing: border-box;
}

.input-field:focus {
  background: #fff;
  box-shadow: 0 2rpx 8rpx rgba(108, 92, 231, 0.06);
  border: 2rpx solid #6C5CE7;
  padding: 0 22rpx;
}

.input-field::placeholder { color: #B8B0CC; font-size: 24rpx; }

/* -------- 反馈列表 -------- */
.feedback-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  padding-bottom: 16rpx;
}

.feedback-item {
  background: #fff;
  border-radius: 20rpx;
  padding: 28rpx;
  box-shadow: 0 4rpx 16rpx rgba(108, 92, 231, 0.06);
}

.fb-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12rpx;
}

.fb-type {
  font-size: 20rpx;
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
  font-weight: 600;
}
.type-suggestion { background: #F0EEFF; color: #6C5CE7; }
.type-bug { background: #FFE8E8; color: #FF6B7A; }
.type-complaint { background: #FFF5E6; color: #E89B3C; }
.type-other { background: #F0F0F0; color: #8E82A5; }

.fb-status {
  font-size: 18rpx;
  padding: 4rpx 14rpx;
  border-radius: 20rpx;
}
.fb-status.pending { background: #FFF5E6; color: #E89B3C; }
.fb-status.resolved { background: #E8FAF3; color: #55C9A6; }

.fb-content {
  font-size: 26rpx;
  color: #2D223C;
  line-height: 1.6;
  display: block;
}

.fb-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 14rpx;
}

.fb-contact {
  font-size: 20rpx;
  color: #8E82A5;
}

.fb-time {
  font-size: 20rpx;
  color: #B8B0CC;
}

.fb-reply {
  margin-top: 14rpx;
  padding: 16rpx 20rpx;
  background: #F8F7FF;
  border-radius: 12rpx;
  border-left: 4rpx solid #6C5CE7;
}

/* 教师回复区 */
.fb-teacher-reply { display:flex; gap:12rpx; margin-top:14rpx; padding-top:14rpx; border-top:2rpx solid #F3EFF9; }
.fb-teacher-reply .reply-input {
  flex:1; height:60rpx; background:#F5F3FA; border-radius:10rpx; padding:0 16rpx; font-size:24rpx; color:#2D223C;
}
.reply-btn { padding:0 24rpx; height:60rpx; line-height:60rpx; background:#6C5CE7; color:#fff; border-radius:10rpx; font-size:24rpx; font-weight:600; }
.reply-btn:active { opacity:0.8; }

.fb-reply-label {
  font-size: 20rpx;
  color: #6C5CE7;
  font-weight: 600;
}

.fb-reply-text {
  font-size: 24rpx;
  color: #2D223C;
  line-height: 1.5;
}

/* -------- 通用提示 -------- */
.loading-tip, .empty-tip {
  text-align: center;
  padding: 48rpx 0;
  font-size: 26rpx;
  color: #B8B0CC;
}
