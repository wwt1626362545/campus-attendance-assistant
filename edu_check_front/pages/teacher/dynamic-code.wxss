/* =============================================
  晨光校园 · 动态码页面样式 v2.0
  ============================================= */

.page-header { margin-bottom: 24rpx; }

/* 动态码卡片 */
.code-card { padding: 28rpx; }

.code-card-header { margin-bottom: 24rpx; }

.code-section-title { font-size: 30rpx; font-weight: 700; color: #2D223C; }

/* 配置区 */
.code-config { margin-bottom: 28rpx; }

.code-config-item { margin-bottom: 24rpx; }

.config-label { font-size: 28rpx; font-weight: 600; color: #2D223C; display: block; margin-bottom: 14rpx; }

.picker-value {
  display: flex;
  align-items: center;
  gap: 10rpx;
  background: #F5F3FA;
  border-radius: 14rpx;
  padding: 22rpx 24rpx;
  font-size: 28rpx;
  color: #2D223C;
}

.picker-label { font-size: 24rpx; }

/* 时长选择 */
.duration-options {
  display: flex;
  gap: 12rpx;
}

.duration-option {
  flex: 1;
  text-align: center;
  padding: 18rpx 0;
  background: #F5F3FA;
  border-radius: 14rpx;
  font-size: 24rpx;
  color: #8E82A5;
  transition: all 0.25s;
}

.duration-option:active { background: #EDE7F6; }

.duration-option.active {
  background: linear-gradient(135deg, #6C5CE7, #A29BFE);
  color: #fff;
  font-weight: 600;
  box-shadow: 0 4rpx 12rpx rgba(108, 92, 231, 0.2);
}

/* 动态码展示 */
.code-display {
  position: relative;
  margin-top: 32rpx;
  padding: 36rpx;
  border-radius: 24rpx;
  background: linear-gradient(135deg, #2D223C, #3D2E5C);
  text-align: center;
  overflow: hidden;
}

.code-display-bg {
  position: absolute;
  top: -80rpx;
  right: -80rpx;
  width: 260rpx;
  height: 260rpx;
  border-radius: 50%;
  background: rgba(162, 155, 254, 0.06);
}

.code-label {
  display: block;
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.5);
  margin-bottom: 16rpx;
  letter-spacing: 4rpx;
}

.code-value {
  display: block;
  font-size: 72rpx;
  font-weight: 800;
  color: #fff;
  letter-spacing: 12rpx;
  font-variant-numeric: tabular-nums;
  margin-bottom: 24rpx;
  text-shadow: 0 2rpx 12rpx rgba(108, 92, 231, 0.3);
}

.code-countdown {
  height: 6rpx;
  background: rgba(255, 255, 255, 0.1);
  border-radius: 4rpx;
  overflow: hidden;
  margin-bottom: 8rpx;
}

.countdown-bar {
  height: 100%;
  background: linear-gradient(90deg, #FF7675, #FDCB6E);
  border-radius: 4rpx;
  transition: width 1s linear;
}

.code-expire {
  display: block;
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.4);
}

/* 历史记录 */
.code-history-card { padding: 28rpx; }

.card-header-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.card-section-title { font-size: 30rpx; font-weight: 700; color: #2D223C; }

.history-list { margin-top: 4rpx; }

.code-history-item {
  padding: 20rpx 0;
  border-bottom: 2rpx solid #F3EFF9;
}

.code-history-item:last-child { border-bottom: none; }

.history-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 6rpx;
}

.history-code-value {
  font-size: 32rpx;
  font-weight: 700;
  color: #2D223C;
  letter-spacing: 4rpx;
}

.history-meta {
  display: flex;
  gap: 20rpx;
  font-size: 22rpx;
  color: #8E82A5;
}
