/* =============================================
  晨光校园 · 教师发布公告页面样式 v2.0
  ============================================= */

.page-container { padding: 32rpx; }
.page-header { margin-bottom: 28rpx; }

/* 操作栏 */
.action-bar { margin-bottom: 24rpx; }
.create-btn { margin: 0 !important; }

/* 加载状态 */
.loading-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 80rpx 0;
  color: #8E82A5;
  font-size: 26rpx;
  gap: 16rpx;
}
.loading-ring {
  width: 48rpx; height: 48rpx;
  border: 4rpx solid #EDE7F6;
  border-top-color: #6C5CE7;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}
@keyframes spin {
  0% { transform: rotate(0deg); }
  100% { transform: rotate(360deg); }
}

/* 公告列表 */
.announce-list { display: flex; flex-direction: column; gap: 20rpx; }
.announce-item { padding: 28rpx; }

.announce-header { display: flex; align-items: center; gap: 12rpx; margin-bottom: 12rpx; }
.type-tag { display: inline-block; padding: 2rpx 14rpx; border-radius: 8rpx; font-size: 20rpx; font-weight: 500; }
.type-tag.notice { background: #F0EEFF; color: #6C5CE7; }
.type-tag.activity { background: #FFF5E6; color: #E89B3C; }
.type-tag.academic { background: #E8FAF3; color: #3BAD85; }
.type-tag.policy { background: #FFEEF0; color: #FF5A6A; }
.announce-top-tag { font-size: 20rpx; color: #E89B3C; font-weight: 500; }

.announce-title { font-size: 30rpx; font-weight: 700; color: #2D223C; display: block; margin-bottom: 8rpx; }
.announce-summary { font-size: 24rpx; color: #8E82A5; display: block; margin-bottom: 14rpx; line-height: 1.5; }
.announce-footer { display: flex; justify-content: space-between; font-size: 22rpx; color: #B8B0CC; }
.announce-reads { font-size: 22rpx; color: #B8B0CC; }

/* 操作按钮 */
.announce-actions {
  display: flex;
  gap: 20rpx;
  margin-top: 16rpx;
  padding-top: 14rpx;
  border-top: 2rpx solid #F3EFF9;
}
.action-edit { font-size: 24rpx; color: #6C5CE7; font-weight: 500; }
.action-delete { font-size: 24rpx; color: #FF5A6A; font-weight: 500; }
.action-edit:active, .action-delete:active { opacity: 0.6; }

/* 弹窗遮罩 */
.form-overlay {
  position: fixed; top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0,0,0,0.4);
  z-index: 1000;
  display: none;
  align-items: center;
  justify-content: center;
}
.form-overlay.show { display: flex; }

/* 弹窗卡片 */
.form-modal {
  width: 680rpx;
  max-height: 80vh;
  background: #fff;
  border-radius: 28rpx;
  overflow: hidden;
  box-shadow: 0 16rpx 48rpx rgba(0,0,0,0.15);
  display: flex;
  flex-direction: column;
}

.form-modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 28rpx 32rpx;
  border-bottom: 2rpx solid #F3EFF9;
}
.form-modal-title { font-size: 32rpx; font-weight: 700; color: #2D223C; }
.form-modal-close {
  width: 48rpx; height: 48rpx;
  border-radius: 50%;
  background: #F5F3FA;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx; color: #8E82A5;
}
.form-modal-close:active { background: #EDE7F6; }

.form-modal-body {
  padding: 32rpx;
  max-height: 60vh;
}

.form-modal-footer {
  display: flex;
  gap: 20rpx;
  padding: 28rpx 32rpx;
  border-top: 2rpx solid #F3EFF9;
}
.form-modal-footer .btn-secondary {
  flex: 1;
  margin: 0 !important;
}
.form-modal-footer .btn-primary {
  flex: 2;
  margin: 0 !important;
  width: auto !important;
}

/* 表单元素 */
.form-group { margin-bottom: 28rpx; }
.form-label { font-size: 28rpx; color: #2D223C; display: block; margin-bottom: 14rpx; font-weight: 600; }

.picker-value {
  display: flex; align-items: center; gap: 10rpx;
  background: #F5F3FA; border-radius: 14rpx;
  padding: 22rpx 24rpx; font-size: 28rpx; color: #2D223C;
}
.picker-value:active { background: #EDE7F6; }

.form-input {
  width: 100%; height: 88rpx;
  background: #F5F3FA; border-radius: 14rpx;
  padding: 0 24rpx; font-size: 28rpx; color: #2D223C;
  transition: all 0.2s;
}
.form-input:focus {
  background: #fff;
  box-shadow: 0 2rpx 8rpx rgba(108,92,231,0.06);
  border: 2rpx solid #6C5CE7;
  padding: 0 22rpx;
}
.form-input::placeholder { color: #B8B0CC; font-size: 26rpx; }

.form-textarea {
  width: 100%;
  background: #F5F3FA; border-radius: 14rpx;
  padding: 22rpx 24rpx; font-size: 28rpx; color: #2D223C;
  height: 200rpx; line-height: 1.6;
}
.form-textarea.large { height: 300rpx; }
.form-textarea:focus {
  background: #fff;
  box-shadow: 0 2rpx 8rpx rgba(108,92,231,0.06);
  border: 2rpx solid #6C5CE7;
  padding: 20rpx 22rpx;
}
.form-textarea::placeholder { color: #B8B0CC; font-size: 26rpx; }

.form-switch-group {
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.form-switch-group .form-label { margin-bottom: 0; }
