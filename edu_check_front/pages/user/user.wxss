/* =============================================
  晨光校园 · 用户中心样式 v2.0
  ============================================= */

.offline-banner {
  display: flex;
  align-items: center;
  gap: 12rpx;
  background: #FFF5E6;
  padding: 16rpx 24rpx;
  border-radius: 16rpx;
  margin-bottom: 24rpx;
  font-size: 24rpx;
  color: #E89B3C;
}

.offline-icon {
  font-size: 28rpx;
}

/* 用户资料头部 */
.profile-section {
  position: relative;
  border-radius: 28rpx;
  overflow: hidden;
  margin-bottom: 28rpx;
  background: linear-gradient(135deg, #6C5CE7 0%, #A29BFE 50%, #B8B0FF 100%);
}

.profile-bg-deco {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  overflow: hidden;
}

.profile-circle {
  position: absolute;
  border-radius: 50%;
  opacity: 0.12;
}

.profile-circle-1 {
  width: 360rpx;
  height: 360rpx;
  background: #fff;
  top: -120rpx;
  right: -80rpx;
}

.profile-circle-2 {
  width: 200rpx;
  height: 200rpx;
  background: #FF7675;
  bottom: -60rpx;
  left: -40rpx;
}

.profile-main {
  position: relative;
  display: flex;
  align-items: center;
  padding: 40rpx 32rpx 28rpx;
  z-index: 1;
}

.profile-avatar-wrap {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  overflow: hidden;
  flex-shrink: 0;
  position: relative;
}

.avatar-ring {
  position: absolute;
  top: -6rpx;
  left: -6rpx;
  width: 132rpx;
  height: 132rpx;
  border-radius: 50%;
  border: 4rpx solid rgba(255, 255, 255, 0.3);
}

.profile-avatar {
  width: 100%;
  height: 100%;
}

.profile-text {
  flex: 1;
  margin-left: 24rpx;
  display: flex;
  flex-direction: column;
}

.profile-name {
  font-size: 38rpx;
  font-weight: 700;
  color: #fff;
  margin-bottom: 4rpx;
  text-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.08);
}

.profile-id {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.75);
  margin-bottom: 2rpx;
}

.profile-college {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.6);
}

.profile-edit-btn {
  padding: 10rpx 28rpx;
  background: rgba(255, 255, 255, 0.2);
  backdrop-filter: blur(4rpx);
  border-radius: 28rpx;
  color: #fff;
  font-size: 24rpx;
  font-weight: 500;
  transition: all 0.2s;
  flex-shrink: 0;
}

.profile-edit-btn:active {
  background: rgba(255, 255, 255, 0.35);
}

/* 统计行 */
.profile-stats {
  position: relative;
  display: flex;
  background: rgba(255, 255, 255, 0.95);
  backdrop-filter: blur(10px);
  margin: 0 16rpx 16rpx;
  border-radius: 16rpx;
  padding: 24rpx 0;
  z-index: 1;
}

.profile-stat-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  border-right: 2rpx solid #EDE7F6;
}

.profile-stat-item:last-child {
  border-right: none;
}

.profile-stat-num {
  font-size: 36rpx;
  font-weight: 800;
  color: #6C5CE7;
  margin-bottom: 4rpx;
  font-variant-numeric: tabular-nums;
}

.profile-stat-label {
  font-size: 22rpx;
  color: #8E82A5;
}

/* 功能菜单 */
.menu-card {
  background: #fff;
  border-radius: 24rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 16rpx rgba(108, 92, 231, 0.08);
}

.menu-section-title {
  padding: 24rpx 32rpx 12rpx;
  font-size: 26rpx;
  font-weight: 600;
  color: #8E82A5;
}

.menu-item {
  display: flex;
  align-items: center;
  padding: 28rpx 32rpx;
  border-bottom: 2rpx solid #F3EFF9;
  transition: all 0.2s;
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-item.no-border {
  border-bottom: none;
}

.menu-hover {
  background: #F8F7FF;
}

.menu-icon-wrap {
  width: 56rpx;
  height: 56rpx;
  border-radius: 14rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.menu-icon-face { background: #F0EEFF; }
.menu-icon-schedule { background: #FFF5E6; }
.menu-icon-feedback { background: #E8FAF3; }
.menu-icon-help { background: #F3E8FF; }
.menu-icon-qa { background: #FFEEF0; }
.menu-icon-switch { background: #F8F7FF; }

.menu-label {
  flex: 1;
  font-size: 28rpx;
  color: #2D223C;
  font-weight: 500;
}

.menu-tag {
  padding: 4rpx 16rpx;
  font-size: 20rpx;
  border-radius: 20rpx;
  margin-right: 12rpx;
}

.tag-done {
  background: #E8FAF3;
  color: #3BAD85;
}

.tag-todo {
  background: #FFEEF0;
  color: #FF5A6A;
}

.menu-arrow {
  font-size: 32rpx;
  color: #B8B0CC;
  font-weight: 300;
}

.menu-desc {
  font-size: 22rpx;
  color: #B8B0CC;
  margin-right: 12rpx;
}
