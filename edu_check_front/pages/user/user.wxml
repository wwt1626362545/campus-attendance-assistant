<view class="page-container">
  <!-- 离线提示 -->
  <view class="offline-banner" wx:if="{{!connected}}">
    <text class="offline-icon">⚠️</text>
    <text>未连接到后端服务器</text>
  </view>

  <!-- 用户信息头部 -->
  <view class="profile-section">
    <view class="profile-bg-deco">
      <view class="profile-circle profile-circle-1"></view>
      <view class="profile-circle profile-circle-2"></view>
    </view>
    <view class="profile-main">
      <view class="profile-avatar-wrap">
        <image src="{{userInfo.avatar || '/images/default_avatar.png'}}" mode="aspectFill" class="profile-avatar"></image>
        <view class="avatar-ring"></view>
      </view>
      <view class="profile-text">
        <text class="profile-name">{{userInfo.name}}</text>
        <text class="profile-id">{{role === 'teacher' ? '教师' : role === 'admin' ? '管理员' : '学生'}} · {{userInfo.studentId}}</text>
        <text class="profile-college">{{userInfo.college}}</text>
      </view>
      <view class="btn-pill btn-pill-primary" bindtap="editProfile"><text>编辑</text></view>
    </view>

    <!-- 学生打卡统计 -->
    <view class="profile-stats" wx:if="{{role !== 'teacher'}}">
      <view class="profile-stat-item" wx:for="{{profileStats}}" wx:key="index">
        <text class="profile-stat-num">{{item.value}}</text>
        <text class="profile-stat-label">{{item.label}}</text>
      </view>
    </view>
  </view>

  <!-- 功能菜单 -->
  <view class="menu-card">
    <view class="menu-section-title">⚙️ 通用功能</view>

    <view class="menu-item" wx:if="{{role !== 'teacher'}}" bindtap="gotoFace" hover-class="menu-hover">
      <view class="menu-icon-wrap menu-icon-face">
        <text>👤</text>
      </view>
      <text class="menu-label">人脸识别</text>
      <view class="menu-tag {{faceRegistered ? 'tag-done' : 'tag-todo'}}">
        {{faceRegistered ? '已录入' : '未录入'}}
      </view>
      <text class="menu-arrow">›</text>
    </view>

    <view class="menu-item" bindtap="gotoCourseSchedule" hover-class="menu-hover">
      <view class="menu-icon-wrap menu-icon-schedule">
        <text>📅</text>
      </view>
      <text class="menu-label">课程表</text>
      <text class="menu-arrow">›</text>
    </view>

    <view class="menu-item" bindtap="gotoFeedback" hover-class="menu-hover">
      <view class="menu-icon-wrap menu-icon-feedback">
        <text>💬</text>
      </view>
      <text class="menu-label">意见反馈</text>
      <text class="menu-arrow">›</text>
    </view>

    <view class="menu-item" bindtap="gotoRepair" hover-class="menu-hover">
      <view class="menu-icon-wrap menu-icon-feedback">
        <text>🔧</text>
      </view>
      <text class="menu-label">宿舍报修</text>
      <text class="menu-arrow">›</text>
    </view>

    <view class="menu-item" wx:if="{{role === 'teacher' || role === 'admin'}}" bindtap="gotoKbUpload" hover-class="menu-hover">
      <view class="menu-icon-wrap menu-icon-face">
        <text>📚</text>
      </view>
      <text class="menu-label">知识库扩充</text>
      <text class="menu-arrow">›</text>
    </view>

    <view class="menu-item" wx:if="{{role === 'teacher' || role === 'admin'}}" bindtap="gotoAdmin" hover-class="menu-hover">
      <view class="menu-icon-wrap menu-icon-qa">
        <text>⚙️</text>
      </view>
      <text class="menu-label">系统管理</text>
      <text class="menu-arrow">›</text>
    </view>

    <view class="menu-item" bindtap="gotoHelp" hover-class="menu-hover">
      <view class="menu-icon-wrap menu-icon-help">
        <text>🤖</text>
      </view>
      <text class="menu-label">智能问答</text>
      <text class="menu-arrow">›</text>
    </view>

    <view class="menu-item" wx:if="{{role === 'teacher' || role === 'admin'}}" bindtap="gotoUnanswered" hover-class="menu-hover">
      <view class="menu-icon-wrap menu-icon-qa">
        <text>📋</text>
      </view>
      <text class="menu-label">未命中问题</text>
      <text class="menu-arrow">›</text>
    </view>

    <view class="menu-item no-border" bindtap="switchAccount" hover-class="menu-hover">
      <view class="menu-icon-wrap menu-icon-switch">
        <text>🔄</text>
      </view>
      <text class="menu-label">切换账号</text>
      <text class="menu-desc">学生/教师/管理员</text>
      <text class="menu-arrow">›</text>
    </view>
  </view>
</view>
