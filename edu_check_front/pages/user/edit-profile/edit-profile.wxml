<view class="page-container">
  <view class="page-header">
    <text class="page-title">📝 编辑资料</text>
    <text class="page-subtitle">修改个人信息</text>
  </view>

  <view class="card edit-card">
    <!-- 头像 -->
    <view class="edit-avatar-row">
      <text class="form-label">头像</text>
      <view class="edit-avatar-wrap" bindtap="changeAvatar">
        <image src="{{avatarUrl || '/images/default_avatar.png'}}" mode="aspectFill" class="edit-avatar"></image>
        <view class="edit-avatar-overlay">
          <text>📷</text>
        </view>
      </view>
    </view>

    <view class="form-group">
      <text class="form-label">姓名</text>
      <input class="form-input" placeholder="请输入姓名" value="{{form.name}}" bindinput="onFieldChange" data-field="name" />
    </view>

    <view class="form-group">
      <text class="form-label">手机号</text>
      <input class="form-input" placeholder="请输入手机号" value="{{form.phone}}" bindinput="onFieldChange" data-field="phone" />
    </view>

    <view class="form-group">
      <text class="form-label">邮箱</text>
      <input class="form-input" placeholder="请输入邮箱" value="{{form.email}}" bindinput="onFieldChange" data-field="email" />
    </view>

    <view class="form-group">
      <text class="form-label">学院</text>
      <input class="form-input" placeholder="请输入学院" value="{{form.college}}" bindinput="onFieldChange" data-field="college" />
    </view>

    <view class="form-group">
      <text class="form-label">专业</text>
      <input class="form-input" placeholder="请输入专业" value="{{form.major}}" bindinput="onFieldChange" data-field="major" />
    </view>

    <view class="form-group">
      <text class="form-label">年级</text>
      <input class="form-input" placeholder="请输入年级" value="{{form.grade}}" bindinput="onFieldChange" data-field="grade" />
    </view>
  </view>

  <button class="btn-primary" bindtap="save" disabled="{{saving}}">
    {{saving ? '⏳ 保存中...' : '✓ 保存修改'}}
  </button>
</view>
