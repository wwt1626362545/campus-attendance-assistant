/* =============================================
  晨光校园 · 历史记录列表通用样式 v2.0
  ============================================= */

.page-header { margin-bottom: 24rpx; }

/* 筛选栏 */
.filter-row {
  display: flex;
  background: #fff;
  border-radius: 16rpx;
  padding: 4rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(108, 92, 231, 0.06);
}

.filter-tab {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  font-size: 24rpx;
  color: #8E82A5;
  border-radius: 12rpx;
  transition: all 0.25s;
}

.filter-tab.active {
  background: linear-gradient(135deg, #6C5CE7, #A29BFE);
  color: #fff;
  font-weight: 600;
  box-shadow: 0 4rpx 12rpx rgba(108, 92, 231, 0.2);
}

/* 统计摘要 */
.summary-bar {
  display: flex;
  background: #fff;
  border-radius: 20rpx;
  padding: 24rpx 0;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(108, 92, 231, 0.08);
}

.summary-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.summary-num {
  font-size: 36rpx;
  font-weight: 800;
  margin-bottom: 4rpx;
  font-variant-numeric: tabular-nums;
}

.summary-label {
  font-size: 20rpx;
  color: #8E82A5;
}

.summary-divider {
  width: 2rpx;
  height: 40rpx;
  background: #EDE7F6;
}

/* 列表 */
.history-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.history-item {
  background: #fff;
  border-radius: 20rpx;
  padding: 28rpx;
  box-shadow: 0 4rpx 16rpx rgba(108, 92, 231, 0.08);
  display: flex;
  align-items: center;
  transition: all 0.2s;
}

.item-hover { transform: scale(0.98); }

.history-left { flex: 1; }
.history-date { font-size: 26rpx; color: #2D223C; font-weight: 500; }
.history-time { font-size: 22rpx; color: #8E82A5; margin-top: 4rpx; display: block; }

.history-right { display: flex; align-items: center; gap: 16rpx; }

.history-detail { font-size: 22rpx; color: #8E82A5; }

.load-more {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  padding: 36rpx 0;
}

.load-more-line { width: 48rpx; height: 2rpx; background: #EDE7F6; }
.load-more-text { font-size: 24rpx; color: #B8B0CC; }
