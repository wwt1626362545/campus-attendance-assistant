/* =============================================
  晨光校园 · 公告页面样式 v2.0
  ============================================= */

/* 页面头部 */
.announce-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.header-actions {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.search-btn {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 2rpx 8rpx rgba(108, 92, 231, 0.08);
}

.search-btn:active {
  transform: scale(0.9);
}

.publish-btn {
  font-size: 24rpx;
  color: #6C5CE7;
  padding: 10rpx 24rpx;
  border: 2rpx solid #6C5CE7;
  border-radius: 28rpx;
  font-weight: 500;
  transition: all 0.2s;
}

.publish-btn:active {
  background: #F0EEFF;
}

/* 搜索栏 */
.search-bar {
  display: flex;
  align-items: center;
  background: #fff;
  border-radius: 20rpx;
  padding: 18rpx 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(108, 92, 231, 0.06);
  transition: all 0.3s ease;
  max-height: 0;
  opacity: 0;
  overflow: hidden;
  padding: 0 24rpx;
  margin-bottom: 0;
}

.search-expand {
  max-height: 120rpx;
  opacity: 1;
  padding: 18rpx 24rpx;
  margin-bottom: 20rpx;
}

.search-icon {
  font-size: 28rpx;
  margin-right: 12rpx;
}

.search-input {
  flex: 1;
  font-size: 26rpx;
  color: #2D223C;
}

.search-clear {
  font-size: 24rpx;
  color: #B8B0CC;
  padding: 8rpx;
}

/* 分类标签 */
.category-scroll {
  white-space: nowrap;
  margin-bottom: 24rpx;
}

.category-list {
  display: flex;
  gap: 16rpx;
  padding: 4rpx 0;
}

.category-tag {
  display: inline-flex;
  padding: 14rpx 28rpx;
  background: #fff;
  border-radius: 32rpx;
  font-size: 24rpx;
  color: #8E82A5;
  box-shadow: 0 2rpx 8rpx rgba(108, 92, 231, 0.06);
  transition: all 0.25s ease;
}

.category-tag.active {
  background: linear-gradient(135deg, #6C5CE7, #A29BFE);
  color: #fff;
  font-weight: 600;
  box-shadow: 0 4rpx 16rpx rgba(108, 92, 231, 0.25);
}

/* 置顶公告卡片（与普通卡片一致） */
.top-card {
  display: flex;
  align-items: flex-start;
  gap: 20rpx;
  padding: 28rpx;
  background: #fff;
  border-radius: 20rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(108, 92, 231, 0.08);
}

.top-badge {
  display: inline-block;
  padding: 4rpx 14rpx;
  background: #F0EEFF;
  color: #6C5CE7;
  font-size: 20rpx;
  border-radius: 8rpx;
  font-weight: 600;
}

.top-body {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.top-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #2D223C;
}

.top-summary {
  font-size: 24rpx;
  color: #8E82A5;
  line-height: 1.5;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.top-meta {
  display: flex;
  gap: 24rpx;
  font-size: 22rpx;
  color: #B8B0CC;
}

.top-arrow {
  font-size: 36rpx;
  color: #D5D0E8;
  align-self: center;
}

/* 公告列表 */
.announce-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.announce-item {
  display: flex;
  gap: 12rpx;
  background: #fff;
  border-radius: 20rpx;
  padding: 28rpx;
  box-shadow: 0 4rpx 16rpx rgba(108, 92, 231, 0.08);
  transition: all 0.2s ease;
  position: relative;
}

.item-active {
  transform: scale(0.98);
  box-shadow: 0 2rpx 8rpx rgba(108, 92, 231, 0.12);
}

.announce-body {
  flex: 1;
  min-width: 0;
}

.announce-top {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-bottom: 8rpx;
}

.type-tag {
  display: inline-block;
  padding: 2rpx 14rpx;
  border-radius: 8rpx;
  font-size: 20rpx;
  font-weight: 500;
}

.type-tag.notice {
  background: #F0EEFF;
  color: #6C5CE7;
}

.type-tag.activity {
  background: #FFF5E6;
  color: #E89B3C;
}

.type-tag.academic {
  background: #E8FAF3;
  color: #3BAD85;
}

.type-tag.policy {
  background: #FFEEF0;
  color: #FF5A6A;
}

.announce-title {
  display: block;
  font-size: 28rpx;
  font-weight: 700;
  color: #2D223C;
  margin-bottom: 6rpx;
  line-height: 1.4;
}

.announce-summary {
  display: block;
  font-size: 24rpx;
  color: #8E82A5;
  line-height: 1.6;
  margin-bottom: 14rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.announce-footer {
  display: flex;
  justify-content: space-between;
  font-size: 22rpx;
  color: #B8B0CC;
}

/* 操作区 */
.announce-actions {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  flex-shrink: 0;
  padding-left: 8rpx;
  border-left: 2rpx solid #F3EFF9;
}

.action-btn {
  width: 52rpx;
  height: 52rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  transition: all 0.2s;
}

.action-btn:active {
  background: #F0EEFF;
  transform: scale(0.9);
}

.fav-active {
  font-size: 28rpx;
}

.teacher-actions {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.announce-date, .announce-reads {
  color: #B8B0CC;
}

/* 加载更多 */
.load-more {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  padding: 36rpx 0;
}

.load-more-line {
  width: 48rpx;
  height: 2rpx;
  background: #EDE7F6;
}

.load-more-text {
  font-size: 24rpx;
  color: #B8B0CC;
}
