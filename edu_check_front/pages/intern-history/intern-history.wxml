<view class="page-container">
  <view class="page-header">
    <text class="page-title">💼 实习打卡记录</text>
    <text class="page-subtitle">查看历史实习签到详情</text>
  </view>

  <view class="summary-bar">
    <view class="summary-item">
      <text class="summary-num" >{{summary.total}}</text>
      <text class="summary-label">总次数</text>
    </view>
    <view class="summary-divider"></view>
    <view class="summary-item">
      <text class="summary-num" >{{summary.present}}</text>
      <text class="summary-label">已签到</text>
    </view>
    <view class="summary-divider"></view>
    <view class="summary-item">
      <text class="summary-num" >{{summary.late}}</text>
      <text class="summary-label">迟到</text>
    </view>
    <view class="summary-divider"></view>
    <view class="summary-item">
      <text class="summary-num" >{{summary.absent}}</text>
      <text class="summary-label">缺勤</text>
    </view>
  </view>

  <view class="history-list">
    <view class="history-item" wx:for="{{list}}" wx:key="index" hover-class="item-hover">
      <view class="history-left">
        <text class="history-date">{{item.date}}</text>
        <text class="history-time">{{item.company}} · {{item.checkinTime}}</text>
      </view>
      <text class="tag {{item.status === 'present' ? 'tag-success' : (item.status === 'late' ? 'tag-warning' : 'tag-danger')}}">
        {{item.status === 'present' ? '✓ 已签到' : (item.status === 'late' ? '⏰ 迟到' : '✕ 缺勤')}}
      </text>
    </view>
  </view>

  <view class="empty-state" wx:if="{{list.length === 0}}">
    <text>📭</text>
    <text>暂无打卡记录</text>
  </view>

  <view class="load-more" wx:if="{{list.length > 0}}" bindtap="loadMore">
    <view class="load-more-line"></view>
    <text class="load-more-text">{{hasMore ? '加载更多' : '没有更多了'}}</text>
    <view class="load-more-line"></view>
  </view>
</view>
